@startuml
title UC-03-06 - Payment Method Validation Swimlane Diagram

skinparam backgroundColor white
skinparam shadowing false
skinparam ArrowColor black
skinparam defaultFontName Arial
skinparam activity {
  BackgroundColor white
  BorderColor black
  FontColor black
  DiamondBackgroundColor white
  DiamondBorderColor black
  StartColor black
  EndColor black
}
skinparam partition {
  BackgroundColor white
  BorderColor black
  FontColor black
}

|Customer|
start
:Select payment method;
:Submit checkout form;

|VietTicket System|
:Validate authentication,\nReservation and payment method;

if (VNPay and active hold?) then (Yes)
  |Booking Database|
  :Create PENDING_PAYMENT Booking;
  :Create PENDING Payment;

  |VietTicket System|
  :Continue to VNPay URL creation\nin UC-03-04;

  |Customer|
  :Follow VNPay redirect;
else (No)
  |VietTicket System|
  :Create no booking or payment;
  :Return unsupported-method\nor expired-hold error;

  |Customer|
  :Select VNPay or restart booking;
endif

|Customer|
stop
@enduml
