@startuml
title UC-03-14 - Admin Booking Management and Statistics Swimlane Diagram

skinparam backgroundColor white
skinparam shadowing false
skinparam ArrowColor black
skinparam defaultFontName Arial
skinparam activity {
  BackgroundColor white
  BorderColor black
  FontColor black
  DiamondBackgroundColor white
  DiamondBorderColor black
  StartColor black
  EndColor black
}
skinparam partition {
  BackgroundColor white
  BorderColor black
  FontColor black
}

|Admin|
start
:Open booking management;
:Enter status, search\nand pagination parameters;

|VietTicket System|
:Verify ADMIN role\nand validate parameters;

if (Request valid?) then (Yes)
  |Booking Database|
  :Query bookings with customer,\nattraction, ticket and payment data;
  :Calculate counts by status,\nrefund-required count and revenue;

  |VietTicket System|
  :Build paginated list\nand statistics block;

  |Admin|
  :View dashboard results;
  :Refine filters or search\nwhen needed;
else (No)
  |VietTicket System|
  :Return authorization\nor parameter error;

  |Admin|
  :Keep page state and\ncorrect the request;
endif

|Admin|
stop
@enduml
