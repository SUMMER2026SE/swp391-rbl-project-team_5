@startuml
title UC-M4.02 - AI Attraction Recommendations Swimlane Diagram

skinparam backgroundColor white
skinparam shadowing false
skinparam ArrowColor black
skinparam defaultFontName Arial
skinparam activity {
  BackgroundColor white
  BorderColor black
  FontColor black
  DiamondBackgroundColor white
  DiamondBorderColor black
  StartColor black
  EndColor black
}
skinparam partition {
  BackgroundColor white
  BorderColor black
  FontColor black
}

|Guest / Customer|
start
:Enter budget, visit date\nand party size;
:Submit preferences;

|VietTicket System|
:Validate preferences\nand rate limit;

if (Request valid?) then (Yes)
  |Attraction Catalogue|
  :Load published attractions,\nprices and availability;

  |AI Service|
  :Rank attractions against\nuser preferences;

  |VietTicket System|
  :Validate recommendations\nand attach booking information;

  if (Recommendations available?) then (Yes)
    |Guest / Customer|
    :View ranked attraction cards;
    :Optionally open an attraction\nto begin UC-03-01;
  else (No)
    :Display load or\nservice error;
  endif
else (No)
  |Guest / Customer|
  :Display preference warning;
endif

|Guest / Customer|
stop
@enduml
