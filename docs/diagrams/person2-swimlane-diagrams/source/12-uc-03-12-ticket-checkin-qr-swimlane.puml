@startuml
title UC-03-12 - Ticket Check-in by QR Swimlane Diagram

skinparam backgroundColor white
skinparam shadowing false
skinparam ArrowColor black
skinparam defaultFontName Arial
skinparam activity {
  BackgroundColor white
  BorderColor black
  FontColor black
  DiamondBackgroundColor white
  DiamondBorderColor black
  StartColor black
  EndColor black
}
skinparam partition {
  BackgroundColor white
  BorderColor black
  FontColor black
}

|Check-in Staff|
start
:Scan QR code or\nenter token manually;

|VietTicket System|
:Normalize VIETTICKET token;

|Ticket Database|
:Load TicketInstance,\nBooking and attraction;

|VietTicket System|
:Verify staff assignment,\nbooking status, ticket status\nand visit date;

if (Ticket eligible?) then (Yes)
  |Ticket Database|
  :Atomically change VALID to USED;
  :Record checkedInAt\nand checkedInById;

  |VietTicket System|
  :Return check-in success;

  |Check-in Staff|
  :Display admitted result;
else (No)
  |VietTicket System|
  :Return not-found, already-used,\ninvalid-date or access reason;

  |Check-in Staff|
  :Display denied result;
endif

|Check-in Staff|
stop
@enduml
