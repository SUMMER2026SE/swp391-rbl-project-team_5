@startuml
title Submit Attraction for Admin Review - Model Class Diagram

skinparam backgroundColor #FFFFFF
skinparam shadowing false
skinparam roundCorner 0
skinparam dpi 170
skinparam defaultFontName Arial
skinparam classFontName Arial
skinparam classAttributeFontName Consolas
skinparam classAttributeIconSize 0
skinparam classBorderColor #263238
skinparam classBackgroundColor #FAFCFD
skinparam classHeaderBackgroundColor #DCEEF8
skinparam ArrowColor #263238
skinparam ArrowThickness 1.2
skinparam linetype ortho
skinparam nodesep 160
skinparam ranksep 140
hide circle

class PartnerProfile <<model>> {
  -id: String {UUID}
  -userId: String {unique}
  -kycConsentAccepted: Boolean = false
  -status: PartnerStatus = PENDING
  --
  +isApproved(): Boolean
}

class Attraction <<model>> {
  -id: String {UUID}
  -partnerId: String
  -title: String
  -submittedData: Json [0..1]
  -revision: Int = 0
  -status: AttractionStatus = DRAFT
  -submittedAt: DateTime [0..1]
  --
  +submitForReview(at: DateTime): void
  +bumpRevision(): void
  +isPublished(): Boolean
  +isOwnedBy(partnerId: String): Boolean
}

class AttractionImage <<model>> {
  -id: String {UUID}
  -attractionId: String
  -imageUrl: String
  -isPrimary: Boolean = false
  --
  +isPrimary(): Boolean
}

class AttractionCategory <<model>> {
  -attractionId: String
  -categoryId: String
  --
  +links(categoryId: String): Boolean
}

class Category <<model>> {
  -id: String {UUID}
  -name: String {unique}
  -isActive: Boolean = true
  --
  +isActive(): Boolean
}

class TicketProduct <<model>> {
  -id: String {UUID}
  -attractionId: String
  -name: String
  -status: TicketStatus = ACTIVE
  --
  +isOnSale(): Boolean
}

class TimeSlot <<model>> {
  -id: String {UUID}
  -ticketProductId: String [0..1]
  -attractionId: String [0..1]
  -startTime: String
  -isActive: Boolean = true
  --
  +isActive(): Boolean
}

PartnerProfile "1" -- "0..*" Attraction : attractions
Attraction "1" *-- "0..*" AttractionImage : images
Attraction "1" *-- "0..*" AttractionCategory : categories
Category "1" -- "0..*" AttractionCategory : attractions
Attraction "1" *-- "0..*" TicketProduct : ticketProducts
TicketProduct "0..1" *-- "0..*" TimeSlot : timeSlots
Attraction "0..1" -- "0..*" TimeSlot : timeSlots

@enduml
