@startuml
title Create Attraction Draft - Model Class Diagram

skinparam backgroundColor #FFFFFF
skinparam shadowing false
skinparam roundCorner 0
skinparam dpi 170
skinparam defaultFontName Arial
skinparam classFontName Arial
skinparam classAttributeFontName Consolas
skinparam classAttributeIconSize 0
skinparam classBorderColor #263238
skinparam classBackgroundColor #FAFCFD
skinparam classHeaderBackgroundColor #DCEEF8
skinparam ArrowColor #263238
skinparam ArrowThickness 1.2
skinparam linetype ortho
skinparam nodesep 160
skinparam ranksep 140
hide circle

class Attraction <<model>> {
  -id: String {UUID}
  -partnerId: String
  -title: String
  -draftData: Json [0..1]
  -status: AttractionStatus = DRAFT
  --
  {static} +createDraft(partnerId: String, title: String): Attraction
  +isPublished(): Boolean
  +isOwnedBy(partnerId: String): Boolean
}

class Category <<model>> {
  -id: String {UUID}
  -name: String {unique}
  -isActive: Boolean = true
  --
  +isActive(): Boolean
}

class AttractionCategory <<model>> {
  -attractionId: String
  -categoryId: String
  --
  {static} +assign(attractionId: String, categoryId: String): AttractionCategory
  +unassign(): void
}

class AttractionImage <<model>> {
  -id: String {UUID}
  -attractionId: String
  -imageUrl: String
  -isPrimary: Boolean = false
  --
  {static} +attach(attractionId: String, imageUrl: String): AttractionImage
}

Attraction "1" *-- "0..*" AttractionCategory : categories
Category "1" -- "0..*" AttractionCategory : attractions
Attraction "1" *-- "0..*" AttractionImage : images

@enduml
