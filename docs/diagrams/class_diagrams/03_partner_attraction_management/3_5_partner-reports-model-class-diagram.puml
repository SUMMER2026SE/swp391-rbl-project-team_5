@startuml
title Partner Reports - Model Class Diagram

skinparam backgroundColor #FFFFFF
skinparam shadowing false
skinparam roundCorner 0
skinparam dpi 170
skinparam defaultFontName Arial
skinparam classFontName Arial
skinparam classAttributeFontName Consolas
skinparam classAttributeIconSize 0
skinparam classBorderColor #263238
skinparam classBackgroundColor #FAFCFD
skinparam classHeaderBackgroundColor #DCEEF8
skinparam ArrowColor #263238
skinparam ArrowThickness 1.2
skinparam linetype ortho
skinparam nodesep 160
skinparam ranksep 140
hide circle

class Booking <<model>> {
  -id: String {UUID}
  -userId: String
  -reservationId: String {unique}
  -status: BookingStatus = PENDING_PAYMENT
  -createdAt: DateTime
  --
  +isPaid(): Boolean
  +isRefundable(at: DateTime): Boolean
}

class Reservation <<model>> {
  -id: String {UUID}
  -userId: String
  -ticketProductId: String
  -status: ReservationStatus = HELD
  -expiresAt: DateTime
  -createdAt: DateTime
  --
  +isExpired(at: DateTime): Boolean
}

class TicketProduct <<model>> {
  -id: String {UUID}
  -attractionId: String
  -name: String
  -status: TicketStatus = ACTIVE
  -createdAt: DateTime
  --
  +isOnSale(): Boolean
}

class Attraction <<model>> {
  -id: String {UUID}
  -partnerId: String
  -title: String
  -status: AttractionStatus = DRAFT
  -createdAt: DateTime
  --
  +isPublished(): Boolean
}

class Payment <<model>> {
  -id: String {UUID}
  -bookingId: String
  -duplicateOfPaymentId: String [0..1]
  -status: PaymentStatus = PENDING
  -isDuplicate: Boolean = false
  -createdAt: DateTime
  --
  +isSucceeded(): Boolean
}

Reservation "1" -- "0..1" Booking : booking
TicketProduct "1" -- "0..*" Reservation : reservations
Attraction "1" *-- "0..*" TicketProduct : ticketProducts
Booking "1" *-- "0..*" Payment : payments
Payment "0..1" -- "0..*" Payment : duplicatePayments
Attraction "0..1" -- "0..*" Booking : snapshotBookings

@enduml
