@startuml
title List Favorites - Model Class Diagram

skinparam backgroundColor #FFFFFF
skinparam shadowing false
skinparam roundCorner 0
skinparam dpi 170
skinparam defaultFontName Arial
skinparam classFontName Arial
skinparam classAttributeFontName Consolas
skinparam classAttributeIconSize 0
skinparam classBorderColor #263238
skinparam classBackgroundColor #FAFCFD
skinparam classHeaderBackgroundColor #DCEEF8
skinparam ArrowColor #263238
skinparam ArrowThickness 1.2
skinparam linetype ortho
skinparam nodesep 160
skinparam ranksep 140
hide circle

class User <<model>> {
  -id: String {UUID}
  -email: String {unique}
  -status: UserStatus = ACTIVE
  -createdAt: DateTime
  --
  +isVerified(): Boolean
  +isActive(): Boolean
}

class FavoriteAttraction <<model>> {
  -userId: String
  -attractionId: String
  -createdAt: DateTime
  --
  +belongsTo(userId: String): Boolean
}

class Attraction <<model>> {
  -id: String {UUID}
  -partnerId: String
  -title: String
  -status: AttractionStatus = DRAFT
  -publicationStatus: AttractionPublicationStatus = PAUSED
  -publishedAt: DateTime [0..1]
  -archivedAt: DateTime [0..1]
  -createdAt: DateTime
  --
  +isPublished(): Boolean
}

class AttractionImage <<model>> {
  -id: String {UUID}
  -attractionId: String
  -imageUrl: String
  -createdAt: DateTime
  --
  +isPrimary(): Boolean
}

class TicketProduct <<model>> {
  -id: String {UUID}
  -attractionId: String
  -name: String
  -status: TicketStatus = ACTIVE
  -archivedAt: DateTime [0..1]
  -createdAt: DateTime
  --
  +isOnSale(): Boolean
}

User "1" *-- "0..*" FavoriteAttraction : favoriteAttractions
Attraction "1" -- "0..*" FavoriteAttraction : favoritedBy
Attraction "1" *-- "0..*" AttractionImage : images
Attraction "1" *-- "0..*" TicketProduct : ticketProducts

@enduml
