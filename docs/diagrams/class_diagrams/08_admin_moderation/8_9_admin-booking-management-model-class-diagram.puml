@startuml
title Admin Booking Management - Model Class Diagram

skinparam backgroundColor #FFFFFF
skinparam shadowing false
skinparam roundCorner 0
skinparam dpi 170
skinparam defaultFontName Arial
skinparam classFontName Arial
skinparam classAttributeFontName Consolas
skinparam classAttributeIconSize 0
skinparam classBorderColor #263238
skinparam classBackgroundColor #FAFCFD
skinparam classHeaderBackgroundColor #DCEEF8
skinparam ArrowColor #263238
skinparam ArrowThickness 1.2
skinparam linetype ortho
skinparam nodesep 160
skinparam ranksep 140
hide circle

class Booking <<model>> {
  -id: String {UUID}
  -userId: String
  -reservationId: String {unique}
  -status: BookingStatus = PENDING_PAYMENT
  -refundRequired: Boolean = false
  -createdAt: DateTime
  --
  +isPaid(): Boolean
  +isRefundable(at: DateTime): Boolean
}

class Payment <<model>> {
  -id: String {UUID}
  -bookingId: String
  -duplicateOfPaymentId: String [0..1]
  -amount: Decimal
  -status: PaymentStatus = PENDING
  -isDuplicate: Boolean = false
  -createdAt: DateTime
  --
  +isSucceeded(): Boolean
  +matchesAmount(amount: Decimal): Boolean
}

class RefundRequest <<model>> {
  -id: String {UUID}
  -bookingId: String
  -amount: Decimal
  -status: RefundStatus = PENDING
  -createdAt: DateTime
  --
  +isPending(): Boolean
}

class TicketInstance <<model>> {
  -id: String {UUID}
  -bookingId: String
  -ticketProductId: String
  -qrCodeToken: String {unique}
  -status: TicketInstanceStatus = VALID
  -createdAt: DateTime
  --
  +isUsable(at: DateTime): Boolean
}

class Reservation <<model>> {
  -id: String {UUID}
  -ticketProductId: String
  -timeSlotId: String [0..1]
  -status: ReservationStatus = HELD
  -expiresAt: DateTime
  -createdAt: DateTime
  --
  +isExpired(at: DateTime): Boolean
}

class TimeSlot <<model>> {
  -id: String {UUID}
  -ticketProductId: String [0..1]
  -startTime: String
  -isActive: Boolean = true
  --
  +isActive(): Boolean
}

class TicketProduct <<model>> {
  -id: String {UUID}
  -attractionId: String
  -name: String
  -status: TicketStatus = ACTIVE
  -createdAt: DateTime
  --
  +isOnSale(): Boolean
}

Reservation "1" -- "0..1" Booking : booking
Booking "1" *-- "0..*" Payment : payments
Payment "0..1" -- "0..*" Payment : duplicatePayments
Booking "1" -- "0..*" RefundRequest : refundRequests
Booking "1" *-- "0..*" TicketInstance : ticketInstances
TicketProduct "1" -- "0..*" TicketInstance : ticketInstances
TicketProduct "1" -- "0..*" Reservation : reservations
TimeSlot "0..1" -- "0..*" Reservation : reservations
TicketProduct "0..1" *-- "0..*" TimeSlot : timeSlots

@enduml
