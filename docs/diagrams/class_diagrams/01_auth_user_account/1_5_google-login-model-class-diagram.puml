@startuml
title Google Login - Model Class Diagram

skinparam backgroundColor #FFFFFF
skinparam shadowing false
skinparam roundCorner 0
skinparam dpi 170
skinparam defaultFontName Arial
skinparam classFontName Arial
skinparam classAttributeFontName Consolas
skinparam classAttributeIconSize 0
skinparam classBorderColor #263238
skinparam classBackgroundColor #FAFCFD
skinparam classHeaderBackgroundColor #DCEEF8
skinparam ArrowColor #263238
skinparam ArrowThickness 1.2
skinparam linetype ortho
skinparam nodesep 160
skinparam ranksep 140
hide circle

class User <<model>> {
  -id: String {UUID}
  -email: String {unique}
  -passwordHash: String {hashed} [0..1]
  -fullName: String
  -provider: AuthProvider = LOCAL
  -isEmailVerified: Boolean = false
  -status: UserStatus = ACTIVE
  --
  {static} +register(email: String, passwordHash: String, fullName: String): User
  +markEmailVerified(): void
  +isVerified(): Boolean
  +isActive(): Boolean
}

class OAuthAccount <<model>> {
  -id: String {UUID}
  -userId: String
  -providerAccountId: String
  -provider: String
  -createdAt: DateTime
  --
  {static} +link(userId: String, provider: String, providerAccountId: String): OAuthAccount
}

class AuthSession <<model>> {
  -id: String {UUID}
  -userId: String
  -tokenHash: String {unique, hashed} [0..1]
  -userAgent: String [0..1]
  -ipAddress: String [0..1]
  -expiresAt: DateTime
  -lastSeenAt: DateTime [0..1]
  --
  {static} +open(userId: String, tokenHash: String, expiresAt: DateTime): AuthSession
}

class UserProfile <<model>> {
  -id: String {UUID}
  -userId: String {unique}
  -phoneNumber: String [0..1]
  -avatarUrl: String [0..1]
  --
  {static} +createFor(userId: String): UserProfile
  +changeAvatar(avatarUrl: String): void
}

User "1" *-- "0..*" OAuthAccount : oauthAccounts
User "1" *-- "0..*" AuthSession : authSessions
User "1" *-- "0..1" UserProfile : profile

@enduml
