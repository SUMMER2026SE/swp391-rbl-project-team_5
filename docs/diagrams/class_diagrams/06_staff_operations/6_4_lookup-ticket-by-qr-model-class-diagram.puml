@startuml
title Lookup Ticket by QR - Model Class Diagram

skinparam backgroundColor #FFFFFF
skinparam shadowing false
skinparam roundCorner 0
skinparam dpi 170
skinparam defaultFontName Arial
skinparam classFontName Arial
skinparam classAttributeFontName Consolas
skinparam classAttributeIconSize 0
skinparam classBorderColor #263238
skinparam classBackgroundColor #FAFCFD
skinparam classHeaderBackgroundColor #DCEEF8
skinparam ArrowColor #263238
skinparam ArrowThickness 1.2
skinparam linetype ortho
skinparam nodesep 160
skinparam ranksep 140
hide circle

class TicketInstance <<model>> {
  -id: String {UUID}
  -bookingId: String
  -ticketProductId: String
  -qrCodeToken: String {unique}
  -status: TicketInstanceStatus = VALID
  --
  +isUsable(at: DateTime): Boolean
  +isCheckedIn(): Boolean
}

class Booking <<model>> {
  -id: String {UUID}
  -userId: String
  -reservationId: String {unique}
  -status: BookingStatus = PENDING_PAYMENT
  -refundRequired: Boolean = false
  --
  +isPaid(): Boolean
}

class Reservation <<model>> {
  -id: String {UUID}
  -ticketProductId: String
  -timeSlotId: String [0..1]
  -status: ReservationStatus = HELD
  -expiresAt: DateTime
  --
  +isExpired(at: DateTime): Boolean
}

class TimeSlot <<model>> {
  -id: String {UUID}
  -ticketProductId: String [0..1]
  -attractionId: String [0..1]
  -startTime: String
  -isActive: Boolean = true
  --
  +isActive(): Boolean
}

class TicketProduct <<model>> {
  -id: String {UUID}
  -attractionId: String
  -name: String
  -status: TicketStatus = ACTIVE
  --
  +isOnSale(): Boolean
}

class Attraction <<model>> {
  -id: String {UUID}
  -partnerId: String
  -title: String
  -status: AttractionStatus = DRAFT
  --
  +isPublished(): Boolean
}

class StaffAttractionAssignment <<model>> {
  -id: String {UUID}
  -staffId: String
  -attractionId: String
  -revokedAt: DateTime [0..1]
  -createdAt: DateTime
  --
  +covers(attractionId: String): Boolean
}

Booking "1" *-- "0..*" TicketInstance : ticketInstances
TicketProduct "1" -- "0..*" TicketInstance : ticketInstances
Reservation "1" -- "0..1" Booking : booking
TicketProduct "1" -- "0..*" Reservation : reservations
TimeSlot "0..1" -- "0..*" Reservation : reservations
TicketProduct "0..1" *-- "0..*" TimeSlot : timeSlots
Attraction "0..1" -- "0..*" TimeSlot : timeSlots
Attraction "1" *-- "0..*" TicketProduct : ticketProducts
Attraction "1" *-- "0..*" StaffAttractionAssignment : staffAssignments
Attraction "0..1" -- "0..*" Booking : snapshotBookings

@enduml
