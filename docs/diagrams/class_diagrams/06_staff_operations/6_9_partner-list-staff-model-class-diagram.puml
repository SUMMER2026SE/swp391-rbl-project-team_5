@startuml
title Partner List Staff - Model Class Diagram

skinparam backgroundColor #FFFFFF
skinparam shadowing false
skinparam roundCorner 0
skinparam dpi 170
skinparam defaultFontName Arial
skinparam classFontName Arial
skinparam classAttributeFontName Consolas
skinparam classAttributeIconSize 0
skinparam classBorderColor #263238
skinparam classBackgroundColor #FAFCFD
skinparam classHeaderBackgroundColor #DCEEF8
skinparam ArrowColor #263238
skinparam ArrowThickness 1.2
skinparam linetype ortho
skinparam nodesep 160
skinparam ranksep 140
hide circle

class User <<model>> {
  -id: String {UUID}
  -employerPartnerId: String [0..1]
  -email: String {unique}
  -passwordHash: String {hashed} [0..1]
  -role: UserRole = CUSTOMER
  -status: UserStatus = ACTIVE
  -createdAt: DateTime
  --
  +isVerified(): Boolean
  +isActive(): Boolean
}

class Attraction <<model>> {
  -id: String {UUID}
  -partnerId: String
  -title: String
  -status: AttractionStatus = DRAFT
  -createdAt: DateTime
  --
  +isPublished(): Boolean
}

class UserProfile <<model>> {
  -id: String {UUID}
  -userId: String {unique}
  -phoneNumber: String [0..1]
  -avatarUrl: String [0..1]
  --
  +isComplete(): Boolean
}

class StaffAttractionAssignment <<model>> {
  -id: String {UUID}
  -staffId: String
  -attractionId: String
  -createdById: String [0..1]
  -revokedAt: DateTime [0..1]
  -createdAt: DateTime
  --
  +covers(attractionId: String): Boolean
}

User "1" *-- "0..1" UserProfile : profile
User "1" -- "0..*" StaffAttractionAssignment : staffAssignments
Attraction "1" *-- "0..*" StaffAttractionAssignment : staffAssignments
User "0..1" -- "0..*" StaffAttractionAssignment : createdStaffAssignments

@enduml
