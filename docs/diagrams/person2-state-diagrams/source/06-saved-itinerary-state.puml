@startuml
title Saved Itinerary State Diagram

top to bottom direction
hide empty description

skinparam backgroundColor white
skinparam shadowing false
skinparam linetype polyline
skinparam ArrowColor black
skinparam state {
  BackgroundColor white
  BorderColor black
  FontColor black
  StartColor black
  EndColor black
}

state "Saved" as SAVED

[*] -down-> SAVED : Itinerary saved

SAVED --> SAVED : [itinerary updated]
SAVED -down-> [*] : [itinerary deleted]

@enduml
