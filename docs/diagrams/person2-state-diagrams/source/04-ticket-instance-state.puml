@startuml
title Ticket Instance State Diagram

top to bottom direction
hide empty description

skinparam backgroundColor white
skinparam shadowing false
skinparam linetype polyline
skinparam ArrowColor black
skinparam state {
  BackgroundColor white
  BorderColor black
  FontColor black
  StartColor black
  EndColor black
}

state "Valid" as VALID
state "Used" as USED
state "Expired" as EXPIRED
state "Refunded" as REFUNDED

[*] -down-> VALID : Ticket issued

VALID -left-> EXPIRED : [visit ended or ticket reissued]
VALID -right-> USED : [check-in accepted]
VALID -down-> REFUNDED : [refund completed]

EXPIRED --> REFUNDED : [eligible refund]

USED --> [*]
REFUNDED --> [*]
EXPIRED --> [*] : [no refund]

@enduml
