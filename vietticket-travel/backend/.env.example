# ============================================
# VietTicket Travel — Backend Environment
# Sao chép file này thành .env rồi điền giá trị thật
# ============================================

# --- Cơ sở dữ liệu PostgreSQL ---
# Định dạng: postgresql://USER:PASSWORD@HOST:PORT/DBNAME?schema=public
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/vietticket?schema=public"

# Thời gian tối đa để khách chọn vé thay thế trong VietTicket Rescue (mili giây).
# Mặc định 24 giờ, tự giới hạn trong 15 phút - 72 giờ và không qua ngày tham quan.
RECOVERY_WINDOW_MS=86400000

# --- Máy chủ ---
PORT=5000
NODE_ENV=development
# Reverse proxy: false nếu chạy trực tiếp; 1 nếu có đúng một load balancer
# (Render/Nginx) phía trước. Có thể dùng số hop hoặc danh sách IP/subnet tin cậy.
TRUST_PROXY=false
# Số VND tương ứng với 1 đơn vị tiền payout. VND luôn dùng tỷ giá 1.
# Ví dụ cấu trúc: {"USD":26000,"EUR":30000,"SGD":20000,"THB":800}
# Giá trị thực tế phải do bộ phận tài chính cập nhật trước khi lập đối soát ngoại tệ.
PAYOUT_EXCHANGE_RATES={}
# Bắt buộc với payout ngoại tệ: nguồn phê duyệt và thời điểm hiệu lực của bảng tỷ giá.
PAYOUT_EXCHANGE_RATE_SOURCE=
PAYOUT_EXCHANGE_RATE_EFFECTIVE_AT=
# Từ chối lập đối soát nếu bảng tỷ giá cũ hơn số giờ này.
PAYOUT_EXCHANGE_RATE_MAX_AGE_HOURS=168
SERVE_FRONTEND=false
# Set true only when the API serves the Vite build from the same origin (e.g. Render).
COOKIE_SECURE=false
# Optional absolute path; defaults to the repository's ../dist directory.
FRONTEND_DIST_DIR=""

# URL frontend (cho CORS) và backend (cho link ảnh upload)
FRONTEND_URL="http://localhost:5173"
BACKEND_URL="http://localhost:5000"

# --- Chính sách đặt vé ---
# Mặc định 20, chỉ chấp nhận số nguyên từ 1 đến 100.
MAX_TICKETS_PER_ORDER=20

# --- JWT ---
# Chuỗi bí mật ngẫu nhiên, đổi thành giá trị riêng của bạn khi triển khai
JWT_SECRET="doi-thanh-mot-chuoi-bi-mat-that-dai-va-ngau-nhien"
JWT_EXPIRES_IN="1d"
# Dùng để ký liên kết hủy nhận bản tin; nên khác JWT_SECRET ở production.
NEWSLETTER_TOKEN_SECRET="doi-thanh-mot-chuoi-bi-mat-ban-tin-rieng"

# --- Tạo tài khoản quản trị bằng npm run create-admin ---
ADMIN_EMAIL=""
ADMIN_PASSWORD=""
ADMIN_FULLNAME="VietTicket Admin"
# Bắt buộc = true nếu chủ động nâng một tài khoản LOCAL hiện có lên ADMIN.
ALLOW_ADMIN_PROMOTION=false

# --- Seed dữ liệu demo (bị cấm khi NODE_ENV=production) ---
ALLOW_DEMO_SEED=false
# Remote defense seed requires both this mode and a one-time explicit flag.
DEPLOYMENT_MODE=local
ALLOW_REMOTE_DEMO_SEED=false
SEED_PARTNER_EMAIL=""
SEED_PARTNER_PASSWORD=""

# --- Tạo/xoay tài khoản platform staff demo ---
ALLOW_DEMO_SCRIPTS=false
STAFF_EMAIL=""
STAFF_PASSWORD=""
STAFF_FULLNAME=""
STAFF_PHONE=""
# Chỉ bật một lần để xoay mật khẩu cho platform STAFF LOCAL hiện có.
ROTATE_EXISTING_STAFF=false

# --- Xác nhận chạy script bảo trì test-db.js ---
ALLOW_DB_MAINTENANCE=false

# --- Google OAuth (tùy chọn) ---
GOOGLE_CLIENT_ID=""

# --- AI Assistant (tùy chọn; điền ít nhất một provider để chatbot gọi AI thật) ---
AI_PRIMARY_PROVIDER="gemini"
GEMINI_API_KEY=""
GEMINI_MODEL="gemini-2.0-flash"
# Gemini 2.5 Flash: 0 tắt thinking cho tác vụ JSON ngắn; -1 bật dynamic thinking.
GEMINI_THINKING_BUDGET="0"
OPENAI_API_KEY=""
OPENAI_MODEL="gpt-4o-mini"

# --- VNPay (Sandbox) ---
# Lấy TmnCode & HashSecret từ tài khoản VNPay Sandbox (https://sandbox.vnpayment.vn)
VNP_TMNCODE=""
VNP_HASHSECRET=""
VNP_URL="https://sandbox.vnpayment.vn/paymentv2/vpcpay.html"
# Return: VNPay redirect trình duyệt về backend để verify rồi chuyển tiếp sang FE
VNP_RETURNURL="http://localhost:5000/api/payments/vnpay-return"
# IPN: VNPay gọi server-to-server để cập nhật DB (khai báo URL này trên cổng VNPay).
# Production phải dùng URL HTTPS công khai; VNPay không thể gọi localhost của máy dev.
# Ở local, vnpay-return có chữ ký hợp lệ sẽ đối soát dự phòng sau khi trình duyệt quay về.
VNP_IPNURL="http://localhost:5000/api/payments/vnpay-ipn"
# API hoàn tiền (refund) — endpoint merchant API của VNPay Sandbox
VNP_API="https://sandbox.vnpayment.vn/merchant_webapi/api/transaction"

# --- Gửi email (tùy chọn — bỏ trống sẽ log ra console ở chế độ dev) ---
SMTP_HOST=""
SMTP_PORT="587"
SMTP_USER=""
SMTP_PASS=""
MAIL_FROM="VietTicket Travel <no-reply@vietticket.com>"

# --- AI Assistant (Chatbot / Gợi ý / Kế hoạch tham quan) ---
# Cấu hình ít nhất 1 trong 2 key dưới đây. Có thể cấu hình cả 2 để
# hệ thống tự fallback sang provider phụ khi provider chính lỗi/hết quota.
GEMINI_API_KEY=""
OPENAI_API_KEY=""
# Provider được thử trước: "gemini" hoặc "openai" (mặc định: gemini)
AI_PRIMARY_PROVIDER="gemini"
# Tuỳ chọn: đổi model cụ thể (có giá trị mặc định nếu để trống)
GEMINI_MODEL="gemini-2.0-flash"
OPENAI_MODEL="gpt-4o-mini"

# --- AI Revenue Forecasting (ml-service FastAPI, ensemble RF + XGBoost) ---
ML_SERVICE_URL="http://localhost:8000"
# Phải khớp với ML_SERVICE_API_KEY trong ml-service/.env; production bắt buộc
# URL không phải localhost và key ngẫu nhiên tối thiểu 32 ký tự.
ML_SERVICE_API_KEY=""
ML_SERVICE_TIMEOUT_MS=8000
# Thời gian (ms) một dự báo đã lưu được coi là còn "mới", tránh gọi lại ml-service liên tục
FORECAST_CACHE_TTL_MS=21600000
# Số ngày doanh thu thực dùng làm lịch sử; hệ thống bỏ ngày hiện tại vì chưa chốt doanh thu
FORECAST_HISTORY_DAYS=180
# Chỉ bật ở local/dev khi model được train bằng seed demo. Production luôn từ chối model demo.
ALLOW_DEMO_AI=false

# Kill switch vận hành cho giá động. Mặc định false: AI chỉ được đề xuất,
# không được thay đổi giá khách trả dù CSDL còn lưu mode AUTO_APPLY.
# Chỉ bật sau khi đã duyệt chính sách giá, cảnh báo và quy trình giám sát.
DYNAMIC_PRICING_AUTO_APPLY_ALLOWED=false

# --- Thanh toán chuyển khoản ngân hàng (VietQR) ---
# Tài khoản NHẬN tiền của nền tảng. Khách quét mã QR trong app ngân hàng,
# không phải nhập số tài khoản thủ công.
# Bỏ trống -> phương thức chuyển khoản tự động bị ẩn, chỉ còn VNPay.
#
# BANK_BIN: mã BIN 6 chữ số của ngân hàng, ví dụ:
#   970436 Vietcombank | 970418 BIDV | 970405 Agribank | 970415 VietinBank
#   970422 MB Bank     | 970407 Techcombank | 970416 ACB | 970432 VPBank
#   970423 TPBank      | 970403 Sacombank
BANK_BIN=""
BANK_ACCOUNT_NUMBER=""
# Tên chủ tài khoản, viết HOA không dấu, đúng như trên sao kê ngân hàng
BANK_ACCOUNT_NAME=""
# Tên ngân hàng hiển thị cho khách (tuỳ chọn)
BANK_NAME=""
# Thời gian giữ chỗ cho đơn chuyển khoản, tính bằng phút.
# Giữ chỗ mặc định của hệ thống chỉ 10 phút — không đủ để khách chuyển tiền rồi
# chờ nhân viên đối chiếu sao kê. Mặc định 60, hệ thống kẹp trong khoảng 15–720.
# Hết hạn mà chưa đối chiếu -> đơn bị hủy và tự động gắn cờ "cần hoàn tiền".
BANK_TRANSFER_HOLD_MINUTES="240"
SEPAY_WEBHOOK_ENABLED=false
SEPAY_WEBHOOK_SECRET=""
SEPAY_WEBHOOK_TOLERANCE_SECONDS=300
APPROVED_VNPAY_WINDOW_MINUTES="60"
MANUAL_APPROVAL_MIN_LEAD_MINUTES="180"
